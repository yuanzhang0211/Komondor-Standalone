+// Sender SR flags are advisory: a TXOP restart can restore power without setting
+// the flag. Key the cache by the actual per-channel TxInfo power on EVERY path.
+void Node :: UpdateReceivedPowerCache(const Notification &notification) {
+	int source = notification.source_id;
+	std::map<int,double>::iterator it = received_power_tx_cache.find(source);
+	if (notification.tx_info.flag_change_in_tx_power || it == received_power_tx_cache.end()
+			|| it->second != notification.tx_info.tx_power) {
+		received_power_array[source] = ComputePowerReceived(distances_array[source],
+			notification.tx_info.tx_power, node_params.central_frequency, node_params.path_loss_model);
+		received_power_tx_cache[source] = notification.tx_info.tx_power;
+	}
+}
+
