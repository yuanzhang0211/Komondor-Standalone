+	printf("FIX_CONTROL;time=%.15f;node=%d;source=%d;type=%d;signal_pw=%.12g;interference_pw=%.12g;sinr=%.12g;loss=%d\n",
+		SimTime(), node_params.node_id, notification.source_id, notification.packet_type,
+		power_rx_interest, max_pw_interference, current_sinr, reason);
+	return reason == PACKET_NOT_LOST;
+}
