+        << ",\"ledger_balance\":" << balance
+        << ",\"in_flight_mpdus\":" << (data_pending ? tx_mpdu.pending.size() : 0)
+        << ",\"cw_min\":" << ca_state.current_cw_min << ",\"cw_max\":" << ca_state.current_cw_max
+        << ",\"backoff_remaining_s\":" << ApJsonNumber(backoff)
